# Copy to .env.local and fill in to skip the credentials form on load.
# Get these from a real Telvoip staging account's
# GET /api/developers/voice/credentials response (sip_username, sip_password,
# sip_domain, wss_url) if you're testing against Telvoip specifically -
# otherwise use any SIP account's credentials.
VITE_SIP_USERNAME=
VITE_SIP_PASSWORD=
VITE_SIP_WSS_URL=wss://app.telvoip.io:7443
VITE_SIP_DOMAIN=
