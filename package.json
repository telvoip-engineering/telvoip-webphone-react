{
  "name": "@telvoip/webphone-react",
  "version": "0.1.0",
  "description": "Portable React hook and drop-in Dialer component for WebRTC/SIP softphones, built on JsSIP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/telvoip-engineering/telvoip-webphone-react.git"
  },
  "keywords": ["webrtc", "sip", "jssip", "softphone", "dialer", "react", "voip"],
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && postcss src/styles/tailwind.css -o dist/style.css && mkdir -p dist/noise-assets && cp src/noise-suppression/assets/*.wasm src/noise-suppression/assets/*.js src/noise-suppression/assets/LICENSE* dist/noise-assets/",
    "build:css": "postcss src/styles/tailwind.css -o dist/style.css",
    "copy:assets": "mkdir -p dist/noise-assets && cp src/noise-suppression/assets/*.wasm src/noise-suppression/assets/*.js src/noise-suppression/assets/LICENSE* dist/noise-assets/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:webrtc": "playwright test --config=playwright.webrtc.config.ts",
    "example:dev": "cd example && bun run dev"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "jssip": "3.13.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "^1.1.0",
    "@types/jssip": "^3.5.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@eslint/js": "^9.0.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
